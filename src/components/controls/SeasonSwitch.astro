---
import { seasonConfig } from "@/config";
---
{seasonConfig.enabled && (
	<div class="season-switch-wrap">
		<button type="button" id="season-switch" class="btn-plain season-switch" aria-label="切换季节" title="切换季节" hidden>
			<svg class="season-emblem" viewBox="0 0 40 40" fill="none" aria-hidden="true" focusable="false">
				<g data-season-art="spring">
					<circle cx="20" cy="20" r="18" fill="#F0F5EB" />
					<path d="M19 31V18m0 9c-7 0-8-5-8-5s7-1 8 5Zm0-4c7 0 9-5 9-5s-7-1-9 5Z" fill="#A4BC94" stroke="#5D805D" stroke-width="1.2" stroke-linejoin="round" />
					<path d="M19 17c-9-1-8-8-3-8 0-6 8-6 8 0 6 0 7 7-2 9Z" fill="#E9C4CB" stroke="#B37E91" stroke-width="1.2" stroke-linejoin="round" />
					<circle cx="20" cy="13" r="2.6" fill="#E4BD77" />
				</g>
				<g data-season-art="summer">
					<circle cx="20" cy="20" r="18" fill="#EDF6F6" />
					<circle cx="24.5" cy="13" r="5" fill="#E8BF79" />
					<path d="M8 23c4-4 8-4 12 0s8 4 12 0M9 28c4-3 7-3 11 0s7 3 11 0" stroke="#4C8998" stroke-width="1.8" stroke-linecap="round" />
					<path d="m14 12-2-2m7-3v-2m12 9h3" stroke="#CFA260" stroke-width="1.3" stroke-linecap="round" />
				</g>
				<g data-season-art="autumn">
					<circle cx="20" cy="20" r="18" fill="#F8F1E6" />
					<path d="M20 29C8 25 6 14 13 9l7 5 7-5c7 5 5 16-7 20Z" fill="#DFBD72" stroke="#A28149" stroke-width="1.3" stroke-linejoin="round" />
					<path d="M20 33V17m0 11-7-11m7 11 7-11m-7 7-4-9m4 9 4-9" stroke="#A28149" stroke-width="1.1" stroke-linecap="round" />
				</g>
				<g data-season-art="winter">
					<circle cx="20" cy="20" r="18" fill="#EEF3F9" />
					<path d="M20 8v24M9.6 14l20.8 12M9.6 26l20.8-12m-14-3 3.6 3.6 3.6-3.6m-7.2 18 3.6-3.6 3.6 3.6M10.4 18.2l4.9-1.3-1.3-4.9m12 16-1.3-4.9 4.9-1.3M14 28l1.3-4.9-4.9-1.3m19.2-3.6-4.9-1.3L26 12" stroke="#6687AA" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
					<circle cx="20" cy="20" r="2" fill="#B4C7DB" />
				</g>
			</svg>
		</button>
		<span class="season-tooltip" aria-hidden="true" data-season-tooltip></span>
		<span id="season-announcement" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></span>
	</div>
)}
