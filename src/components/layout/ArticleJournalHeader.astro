---
import type { MarkdownHeading } from "astro";
import { profileConfig } from "@/config";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getCategoryUrl, getTagUrl } from "@/utils/url-utils";

interface Props {
	title: string;
	description?: string;
	category?: string;
	tags: string[];
	author?: string;
	published: Date;
	updated?: Date;
	draft?: boolean;
	words: number;
	minutes: number;
	headings: MarkdownHeading[];
	encrypted: boolean;
}
const {
	title,
	description,
	category,
	tags,
	author,
	published,
	updated,
	draft,
	words,
	minutes,
	headings,
	encrypted,
} = Astro.props;
// 加密文章的标题目录继续由原有解密流程管理，不能在这里泄露。
const toc = encrypted ? [] : headings.filter((heading) => heading.depth <= 3);
---

<header class="article-journal-header">
	<div class="article-journal-eyebrow inner-eyebrow">
		{category ? <a href={getCategoryUrl(category)}>{category}</a> : <span>四时手记</span>}
		{draft && <span class="article-journal-draft">草稿</span>}
	</div>
	<h1 data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title">{title}</h1>
	{description && <p class="article-journal-description">{description}</p>}
	<div class="article-journal-meta">
		<time datetime={published.toISOString()}>{formatDateToYYYYMMDD(published)}</time>
		<span>{author || profileConfig.name}</span>
		<span>{words} 字 · 约 {minutes} 分钟</span>
		{updated && updated.getTime() !== published.getTime() && <span>更新于 <time datetime={updated.toISOString()}>{formatDateToYYYYMMDD(updated)}</time></span>}
		{encrypted && <span>加密文章</span>}
	</div>
	{tags.length > 0 && <div class="article-journal-tags">{tags.map((tag) => <a href={getTagUrl(tag)}>#{tag}</a>)}</div>}
	{toc.length > 0 && <details class="article-journal-toc">
		<summary>本文目录</summary>
		<nav aria-label="本文目录">{toc.map((heading) => <a href={`#${heading.slug}`} style={heading.depth > 2 ? "padding-inline-start: 12px" : undefined}>{heading.text}</a>)}</nav>
	</details>}
</header>
